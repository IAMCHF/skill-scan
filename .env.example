# ──────────────────────────────────────────────
# SkillScan 环境变量配置示例（.env.example）
# 复制为 .env.dev / .env.test / .env.prod 使用
# ──────────────────────────────────────────────
# 应用环境 (dev / test / prod)
APP_ENV=dev

# ════════════════════════════════════════════════
# LLM 审查 API（质量优先，如 gpt-4o）
# ════════════════════════════════════════════════
LLM_API_URL=https://yice.byd.com/ai-gate/v1/chat/completions
LLM_API_KEY=sk-qHh8Osvoso2eyBvehLumzQHxdgSnGbMqZQHWyEJShQvD2Gv1
LLM_MODEL=Qwen3.8-Flash-Next
LLM_TIMEOUT=300
# LLM_MAX_TOKENS: 模型输出 token 上限（需小于模型上下文窗口 196608）
LLM_MAX_TOKENS=16384

# ════════════════════════════════════════════════
# LLM 翻译 API（快速模型，如 gpt-4o-mini）
# 不设置则复用审查 LLM 的配置
# ════════════════════════════════════════════════
TRANSLATE_LLM_API_URL=https://yice.byd.com/ai-gate/v1/chat/completions
TRANSLATE_LLM_API_KEY=sk-qHh8Osvoso2eyBvehLumzQHxdgSnGbMqZQHWyEJShQvD2Gv1
TRANSLATE_LLM_MODEL=Qwen3.8-Flash-Next
TRANSLATE_LLM_TIMEOUT=300
# TRANSLATE_LLM_MAX_TOKENS: 翻译模型输出 token 上限
TRANSLATE_LLM_MAX_TOKENS=16384
